# Copy this file to `.env` and fill in your real keys. Never commit `.env`.

# Required — Claude API (decision engine)
ANTHROPIC_API_KEY=

# Optional — Notion logging. If NOTION_API_KEY or NOTION_DATABASE_ID is blank,
# Notion logging is skipped (the agent still runs and logs locally).
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Optional — CoinGecko. Works without a key on the free public endpoint, but a
# demo/pro key raises rate limits. Set COINGECKO_API_TIER to "demo" or "pro".
COINGECKO_API_KEY=
COINGECKO_API_TIER=demo

# Optional — NewsAPI (newsapi.org free tier). If blank, the agent falls back to
# free RSS feeds for headlines.
NEWS_API_KEY=

# Optional — Email notifications. Set EMAIL_TO *and* SMTP_HOST to enable; if
# either is blank, email is skipped. Gmail example shown (use an App Password,
# not your account password). Port 587 = STARTTLS, 465 = SSL.
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional — Dead man's switch (cron monitor). The agent pings this URL on every
# successful run; if a ping is missed within the window you set on the service,
# IT alerts you that a run was skipped entirely. Get a URL from healthchecks.io
# (free), Better Stack, Cronitor, etc. On failure the agent hits <url>/fail.
HEARTBEAT_URL=
